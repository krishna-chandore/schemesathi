# =============================================================================
# SchemeSathi App — .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
google-services.json
GoogleService-Info.plist

# Dart & Flutter artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/*.keystore
android/*.jks
android/app/debug/
android/app/profile/
android/app/release/

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/flutter_assets/
ios/Pods/
ios/.symlinks/
*.xcworkspace
*.xcuserdata

# macOS / Linux / Windows
macos/Flutter/ephemeral/
macos/Pods/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# IDE & Editor
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# OS
.DS_Store
Thumbs.db
