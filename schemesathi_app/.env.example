# =============================================================================
# SchemeSathi App — Environment Template
# Copy this file to `.env` and fill in your values.
# =============================================================================

# Clerk Authentication Configuration
# Replace with your actual Clerk Publishable Key from https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# FastAPI Backend URL
# For Web/Local Emulator: http://127.0.0.1:8001
# For Physical Android devices on local Wi-Fi: http://<YOUR_LOCAL_IP>:8001
BACKEND_URL=http://127.0.0.1:8001
