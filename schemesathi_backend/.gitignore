# =============================================================================
# SchemeSathi Backend — .gitignore
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.egg
*.egg-info/
dist/
build/
.eggs/

# Environments
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# Testing & quality
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs & scratch scripts
logs/
*.log
scratch_*.py
scraped_*.json
.myscheme_dataset_cache.json

# IDE & OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
