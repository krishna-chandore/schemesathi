# =============================================================================
# SchemeSathi Backend — Environment Template
# Copy this file to `.env` and fill in your values.
# =============================================================================

# ── MongoDB Connection ────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=SchemeSathi
COLLECTION_NAME=form_submissions
MONGO_DB=SchemeSathi
SCHEMES_COLLECTION=schemes

# ── Redis Cache (Optional for scraper & recommendation caching) ───────────────
REDIS_URL=redis://default:<PASSWORD>@<HOST>:<PORT>
REDIS_ENABLED=false
REDIS_KEY_PREFIX=schemesathi:schemes

# ── Scraper Settings ──────────────────────────────────────────────────────────
BASE_URL=https://www.myscheme.gov.in
API_URL=https://api.myscheme.gov.in/search/v6/schemes
DETAIL_API_URL=https://api.myscheme.gov.in/schemes/v6/public/schemes
DOCUMENTS_API_URL=https://api.myscheme.gov.in/schemes/v6/public/schemes/{id}/documents
DATASET_JSON=https://raw.githubusercontent.com/Aryan-Pardeshi/gov-myscheme-dataset/main/gov_myscheme_data.json
DATASET_CSV=https://raw.githubusercontent.com/Aryan-Pardeshi/gov-myscheme-dataset/main/gov_myscheme_data.csv

# ── Worker Schedule & Batching ────────────────────────────────────────────────
UPDATE_INTERVAL_HOURS=6
RUN_ON_STARTUP=true
LOG_LEVEL=INFO

BATCH_SIZE=4
BATCH_DELAY_SECONDS=30
RATE_LIMIT_BACKOFF_SECONDS=60
SCRAPE_RETRY_BACKOFF=5.0
SCRAPE_RETRIES=3
STATE_DELAY_SECONDS=2.0
MYSCHEME_WORKERS=2
MYSCHEME_PREFETCH_DELAY=0.5

# ── Clerk Authentication (Backend Admin API) ──────────────────────────────────
# Obtain from Clerk Dashboard -> API Keys -> Secret Key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
